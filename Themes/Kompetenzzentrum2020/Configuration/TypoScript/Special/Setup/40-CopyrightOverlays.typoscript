# Keep the TYPO3 v10 copyright overlay implementation inside rkw_template.
# Some extensions copy the Accelerator FLUIDTEMPLATE during setup, therefore
# their already-created copies must explicitly use the local template as well.

lib.txAccelerator.responsiveImage.file = EXT:rkw_template/Themes/Kompetenzzentrum2020/Resources/Private/Templates/FluidTemplateLibs/ResponsiveImages.html
lib.txAccelerator.responsiveImage.settings < lib.txRkwTemplate.themeSettings

